{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "cadmus-shell-v3": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/cadmus-shell-v3",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "polyfills": ["@angular/localize/init"],
            "tsConfig": "tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              },
              {
                "glob": "**/*",
                "input": "node_modules/monaco-editor/min/vs",
                "output": "vs"
              }
            ],
            "styles": ["src/styles.scss"],
            "scripts": [],
            "allowedCommonJsDependencies": [
              "dagre",
              "webcola",
              "ngraph.graph",
              "ngraph.forcelayout"
            ]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "5MB",
                  "maximumError": "6MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            },
            "testing": {
              "aot": false,
              "optimization": false,
              "extractLicenses": false
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "prebundle": {
              "exclude": [
                "@myrmidon/auth-jwt-admin",
                "@myrmidon/auth-jwt-login",
                "@myrmidon/cadmus-api",
                "@myrmidon/cadmus-mat-physical-size",
                "@myrmidon/cadmus-mat-physical-state",
                "@myrmidon/cadmus-refs-asserted-chronotope",
                "@myrmidon/cadmus-refs-asserted-ids",
                "@myrmidon/cadmus-refs-assertion",
                "@myrmidon/cadmus-refs-biblissima-lookup",
                "@myrmidon/cadmus-refs-citation",
                "@myrmidon/cadmus-refs-decorated-counts",
                "@myrmidon/cadmus-refs-doc-references",
                "@myrmidon/cadmus-refs-geonames-lookup",
                "@myrmidon/cadmus-refs-historical-date",
                "@myrmidon/cadmus-refs-lookup",
                "@myrmidon/cadmus-refs-proper-name",
                "@myrmidon/cadmus-refs-viaf-lookup",
                "@myrmidon/cadmus-text-block-view",
                "@myrmidon/cadmus-text-ed",
                "@myrmidon/cadmus-text-ed-md",
                "@myrmidon/cadmus-text-ed-txt",
                "@myrmidon/cadmus-thesaurus-store",
                "@myrmidon/cadmus-ui-flag-set",
                "@myrmidon/cadmus-ui-note-set",
                "@myrmidon/cadmus-ui-object-view",
                "@myrmidon/ngx-mat-tools",
                "@myrmidon/ngx-tools",
                "@myrmidon/paged-data-browsers",
                "@myrmidon/taxo-store-api",
                "@myrmidon/taxo-store-editor",
                "@myrmidon/taxo-store-picker"
              ]
            }
          },
          "configurations": {
            "production": {
              "buildTarget": "cadmus-shell-v3:build:production"
            },
            "development": {
              "buildTarget": "cadmus-shell-v3:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "extract-i18n": {
          "builder": "@angular/build:extract-i18n"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "tsconfig.spec.json",
            "buildTarget": ":build:testing",
            "runner": "vitest"
          }
        }
      }
    },
    "@myrmidon/cadmus-api": {
      "projectType": "library",
      "root": "projects/myrmidon/cadmus-api",
      "sourceRoot": "projects/myrmidon/cadmus-api",
      "prefix": "cadmus",
      "architect": {
        "build": {
          "builder": "@angular/build:library",
          "options": {
            "tsConfig": "projects/myrmidon/cadmus-api/tsconfig.lib.json",
            "outputPath": "dist/myrmidon/cadmus-api"
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/myrmidon/cadmus-api/tsconfig.lib.prod.json"
            },
            "development": {
